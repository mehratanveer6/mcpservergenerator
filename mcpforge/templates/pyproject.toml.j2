[project]
name = "{{ server_name|replace('_', '-') }}-mcp"
version = "1.0.0"
description = "MCP server for {{ title }} (API version {{ api_version }}), generated by MCPForge"
requires-python = ">=3.10"
dependencies = ["mcp>=2.3,<3", "httpx>=0.27", "pydantic>=2.7"]

[project.optional-dependencies]
aws = ["boto3>=1.34"]
