"""{{ title }} MCP server.

Generated by MCPForge {{ forge_version }} from {{ source_name }}.
{{ n_ops }} operations in the catalog, {{ direct|length }} exposed as direct tools.

Environment variables
  API_BASE_URL          override the server URL from the spec (default {{ base_url or "not set" }})
  MCPFORGE_POLICY       read_only | read_write (default) | full
  API_KEY / API_TOKEN / API_USERNAME / API_PASSWORD   credentials, see README
  EXTRA_HEADERS         JSON object of headers added to every request
  ROUTER_BACKEND        bm25 (default) | embedding (needs vectors + AWS credentials)
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path
from typing import Annotated, Any
from urllib.parse import quote

import httpx
from mcp.server.mcpserver import MCPServer
from mcp.server.mcpserver.exceptions import ToolError
from mcp.types import ToolAnnotations
from pydantic import Field

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from router import BM25Router, EmbeddingRouter, document_for  # noqa: E402

CATALOG = json.loads((HERE / "catalog.json").read_text(encoding="utf-8"))
OPS: dict[str, dict] = {e["operation_id"]: e for e in CATALOG["operations"]}
BY_TOOL_NAME: dict[str, dict] = {e["tool_name"]: e for e in CATALOG["operations"]}

BASE_URL = os.environ.get("API_BASE_URL", CATALOG["base_url"]).rstrip("/")
POLICY = os.environ.get("MCPFORGE_POLICY", "read_write")
ALLOWED = {
    "read_only": {"read"},
    "read_write": {"read", "write"},
    "full": {"read", "write", "destructive"},
}.get(POLICY, {"read"})
TIMEOUT = float(os.environ.get("API_TIMEOUT_SECONDS", "30"))
MAX_CHARS = int(os.environ.get("MAX_RESPONSE_CHARS", "20000"))

mcp = MCPServer(
    name={{ server_name|pyrepr }},
    version={{ api_version|pyrepr }},
    instructions={{ instructions|pyrepr }},
)


def _auth(headers: dict[str, str], query: dict[str, Any]) -> httpx.Auth | None:
    """Apply credentials for the security schemes declared in the spec."""
    for scheme in CATALOG.get("auth", []):
        kind = scheme.get("type")
        if kind == "apiKey" and os.environ.get("API_KEY"):
            if scheme.get("in") == "query":
                query[scheme["name"]] = os.environ["API_KEY"]
            elif scheme.get("in") == "cookie":
                headers["Cookie"] = f"{scheme['name']}={os.environ['API_KEY']}"
            else:
                headers[scheme.get("name", "X-API-Key")] = os.environ["API_KEY"]
        elif kind == "basic" and os.environ.get("API_USERNAME"):
            return httpx.BasicAuth(os.environ["API_USERNAME"], os.environ.get("API_PASSWORD", ""))
        elif kind == "bearer" and os.environ.get("API_TOKEN"):
            headers["Authorization"] = f"Bearer {os.environ['API_TOKEN']}"
    if not CATALOG.get("auth") and os.environ.get("API_TOKEN"):
        headers["Authorization"] = f"Bearer {os.environ['API_TOKEN']}"
    return None


async def _execute(operation_id: str, args: dict[str, Any]) -> str:
    entry = OPS[operation_id]
    if entry["risk"] not in ALLOWED:
        raise ToolError(
            f"'{entry['tool_name']}' is classified as {entry['risk']} and is disabled under policy "
            f"'{POLICY}'. Set MCPFORGE_POLICY=full only if the user has approved this action."
        )
    path, query = entry["path"], {}
    headers = {"Accept": "application/json", "User-Agent": "mcpforge-generated/1.0"}
    headers.update(json.loads(os.environ.get("EXTRA_HEADERS", "{}") or "{}"))
    for p in entry["params"]:
        value = args.get(p["arg"])
        if value is None:
            if p["required"]:
                raise ToolError(f"missing required parameter '{p['arg']}'")
            continue
        if p["in"] == "path":
            path = path.replace("{" + p["name"] + "}", quote(str(value), safe=""))
        elif p["in"] == "query":
            query[p["name"]] = value
        elif p["in"] == "header":
            headers[p["name"]] = str(value)
        elif p["in"] == "cookie":
            headers["Cookie"] = f"{p['name']}={value}"
    body = None
    spec_body = entry.get("body")
    if spec_body and spec_body["mode"] == "fields":
        body = {f["name"]: args[f["arg"]] for f in spec_body["fields"] if args.get(f["arg"]) is not None}
    elif spec_body and spec_body["mode"] == "whole":
        body = args.get("body")
    if spec_body and spec_body.get("required") and body in (None, {}):
        raise ToolError("this operation requires a request body")
    auth = _auth(headers, query)
    kwargs: dict[str, Any] = {}
    if body is not None:
        if spec_body and "form" in spec_body.get("content_type", ""):
            kwargs["data"] = body
        else:
            kwargs["json"] = body
    try:
        async with httpx.AsyncClient(timeout=TIMEOUT, follow_redirects=True) as client:
            resp = await client.request(entry["method"], BASE_URL + path, params=query, headers=headers,
                                        auth=auth, **kwargs)
    except httpx.HTTPError as exc:
        raise ToolError(f"request to {BASE_URL + path} failed: {type(exc).__name__}: {exc}") from exc
    text = resp.text
    if len(text) > MAX_CHARS:
        text = text[:MAX_CHARS] + f"\n...[truncated {len(resp.text) - MAX_CHARS} characters]"
    if resp.status_code >= 400:
        raise ToolError(f"HTTP {resp.status_code} from {entry['method']} {entry['path']}: {text[:2000]}")
    return text or f"HTTP {resp.status_code} (empty body)"

{% for t in direct %}

async def {{ t.tool_name }}({{ t.signature }}) -> str:
    return await _execute({{ t.operation_id|pyrepr }}, { {%- for a in t.args %}{{ a.arg|pyrepr }}: {{ a.arg }}{{ ", " if not loop.last }}{% endfor -%} })
{% endfor %}


DIRECT_TOOLS = [
{%- for t in direct %}
    ({{ t.tool_name }}, {{ t.tool_name|pyrepr }}, {{ t.description|pyrepr }}, {{ t.risk|pyrepr }}, {{ t.hints|pyrepr }}),
{%- endfor %}
]

for _fn, _name, _description, _risk, _hints in DIRECT_TOOLS:
    if _risk in ALLOWED:
        mcp.add_tool(_fn, name=_name, description=_description, annotations=ToolAnnotations(**_hints))


def _build_router():
    entries = [e for e in CATALOG["operations"]]
    ids = [e["operation_id"] for e in entries]
    if os.environ.get("ROUTER_BACKEND") == "embedding" and all("vector" in e for e in entries):
        import boto3  # only needed for the embedding back end

        client = boto3.client("bedrock-runtime")
        model = os.environ.get("BEDROCK_EMBED_MODEL_ID", "amazon.titan-embed-text-v2:0")
        dims = len(entries[0]["vector"])

        def embed(text: str) -> list[float]:
            body = json.dumps({"inputText": text, "dimensions": dims, "normalize": True})
            out = client.invoke_model(modelId=model, body=body)
            return json.loads(out["body"].read())["embedding"]

        return EmbeddingRouter([e["vector"] for e in entries], ids, embed)
    return BM25Router([document_for(e) for e in entries], ids)


ROUTER = _build_router()


@mcp.tool(
    name="search_operations",
    description=(
        "Search all {{ n_ops }} operations of the {{ title|replace('"', '') }} API by intent, including ones not "
        "exposed as direct tools. Returns operation ids, risk level and parameters. "
        "Run a result with call_operation."
    ),
    annotations=ToolAnnotations(read_only_hint=True, destructive_hint=False, idempotent_hint=True,
                                open_world_hint=False),
)
async def search_operations(
    query: Annotated[str, Field(description="What you want to do, in plain language")],
    limit: Annotated[int, Field(description="Maximum results (1-20)")] = 5,
) -> str:
    hits = ROUTER.search(query, k=max(1, min(limit, 20)) * 2)
    out = []
    for op_id, score in hits:
        e = OPS[op_id]
        out.append({
            "operation_id": op_id, "score": score, "risk": e["risk"],
            "enabled": e["risk"] in ALLOWED, "description": e["description"],
            "parameters": [{"name": p["arg"], "in": p["in"], "required": p["required"], "type": p["type"]}
                           for p in e["params"]]
            + [{"name": f["arg"], "in": "body", "required": f["required"], "type": f["type"]}
               for f in (e.get("body") or {}).get("fields", [])]
            + ([{"name": "body", "in": "body", "required": e["body"].get("required", False), "type": "object"}]
               if (e.get("body") or {}).get("mode") == "whole" else []),
        })
        if len(out) >= limit:
            break
    return json.dumps(out, indent=1)


@mcp.tool(
    name="call_operation",
    description=(
        "Call any operation returned by search_operations. Pass its operation_id and an arguments object "
        "using the parameter names from the search result. Destructive operations are refused unless the "
        "server runs with MCPFORGE_POLICY=full."
    ),
    annotations=ToolAnnotations(read_only_hint=False, destructive_hint=POLICY == "full", idempotent_hint=False,
                                open_world_hint=True),
)
async def call_operation(
    operation_id: Annotated[str, Field(description="operation_id from search_operations")],
    arguments: Annotated[dict[str, Any] | None, Field(description="Arguments keyed by parameter name")] = None,
) -> str:
    entry = OPS.get(operation_id) or BY_TOOL_NAME.get(operation_id)
    if entry is None:
        raise ToolError(f"unknown operation '{operation_id}'; use search_operations first")
    args = dict(arguments or {})
    for item in entry["params"] + (entry.get("body") or {}).get("fields", []):
        if item["name"] in args and item["arg"] not in args:
            args[item["arg"]] = args.pop(item["name"])
    return await _execute(entry["operation_id"], args)


if __name__ == "__main__":
    transport = os.environ.get("MCP_TRANSPORT", "stdio")
    if transport == "streamable-http":
        mcp.run(transport="streamable-http")
    else:
        mcp.run()
